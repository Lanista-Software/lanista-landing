{
  "id": "products",
  "name": "Products",
  "kind": "collection",
  "domain": "marketing",
  "i18n": true,
  "title_field": "name",
  "description": "Lanista's product portfolio (Turkish market): e-Dönüşüm products, sector apps for businesses and the software service. Source: docs/urun-portfoyu.md (internal table) + docs/urunler-ve-iyzico-brief.md. Voice rules §8: plain shopkeeper language; never mention user management, margins, costs or customer names; planned features are 'ekleniyor', never 'eksik'. Do not name the e-invoice provider in copy until company.einvoice_provider is set. Never store demo login credentials here.",
  "fields": {
    "desktop_screenshots": {
      "items": "image",
      "max": 8,
      "order": 14.7,
      "type": "array"
    },
    "einvoice_note": {
      "description": "How the product relates to e-Fatura, shown on cards, e.g. 'e-Fatura dahil'.",
      "max": 60,
      "order": 6.7,
      "type": "string"
    },
    "faq": {
      "items": {
        "fields": {
          "answer": {
            "max": 600,
            "required": true,
            "type": "text"
          },
          "question": {
            "max": 140,
            "required": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "max": 12,
      "order": 13,
      "type": "array"
    },
    "feature_groups": {
      "items": {
        "fields": {
          "items": {
            "items": "string",
            "max": 8,
            "type": "array"
          },
          "title": {
            "max": 60,
            "required": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "order": 10,
      "type": "array"
    },
    "featured": {
      "description": "Shown as the large picture card in the header menu (one entry).",
      "order": 4.5,
      "type": "boolean"
    },
    "group": {
      "description": "Menu and catalogue group.",
      "options": [
        "e-donusum",
        "isletme",
        "hizmet"
      ],
      "order": 2.5,
      "required": true,
      "type": "select"
    },
    "hero_screenshot": {
      "description": "Phone screenshot (390×844) shown in the hero phone frame.",
      "order": 14.5,
      "type": "image"
    },
    "hero_text": {
      "max": 220,
      "order": 8,
      "required": true,
      "type": "text"
    },
    "hero_title": {
      "max": 70,
      "order": 7,
      "required": true,
      "type": "string"
    },
    "icon": {
      "description": "Remixicon name for the menu, e.g. ri-file-text-line.",
      "order": 15.5,
      "type": "icon"
    },
    "illustration": {
      "description": "Ludus-style SVG for cards and the menu feature card (docs/illustration-style.md).",
      "order": 15,
      "type": "image"
    },
    "keywords": {
      "description": "Target search terms (e.g. veresiye programı).",
      "items": "string",
      "max": 12,
      "order": 18,
      "type": "array"
    },
    "launch_date": {
      "description": "Planned sales start. Informational on the live site; with LAUNCH_PREVIEW=1 the product is shown as live (plans and prices visible). Going live is still manual: set status to live.",
      "order": 3.6,
      "type": "date"
    },
    "link_to": {
      "default": "product",
      "description": "Where the entry's page lives. product = /urunler/{slug}/ (generated). e-donusum = the /e-donusum/ hub (Turkish only; hidden in English). services = /hizmetler/. Non-product entries get no /urunler/ page.",
      "options": [
        "product",
        "e-donusum",
        "services"
      ],
      "order": 2.6,
      "type": "select"
    },
    "menu_text": {
      "description": "Short line under the name in the header menu.",
      "max": 60,
      "order": 6.5,
      "type": "string"
    },
    "name": {
      "label": {
        "en": "Product name",
        "tr": "Ürün adı"
      },
      "max": 40,
      "order": 1,
      "required": true,
      "type": "string"
    },
    "order": {
      "description": "Sort order inside its group.",
      "order": 4,
      "type": "integer"
    },
    "pains": {
      "description": "Bugünkü dert → ne yapıyor",
      "items": {
        "fields": {
          "pain": {
            "max": 120,
            "required": true,
            "type": "string"
          },
          "solution": {
            "max": 220,
            "required": true,
            "type": "text"
          }
        },
        "type": "object"
      },
      "max": 6,
      "order": 9,
      "type": "array"
    },
    "roadmap": {
      "description": "Planned features ('ekleniyor').",
      "items": "string",
      "max": 8,
      "order": 11,
      "type": "array"
    },
    "screenshots": {
      "items": "image",
      "max": 8,
      "order": 14,
      "type": "array"
    },
    "sector": {
      "label": {
        "en": "Audience",
        "tr": "Kimin için"
      },
      "max": 80,
      "order": 5,
      "required": true,
      "type": "string"
    },
    "seo_description": {
      "max": 160,
      "order": 17,
      "type": "text"
    },
    "seo_title": {
      "max": 60,
      "order": 16,
      "type": "string"
    },
    "slug": {
      "description": "URL: /urunler/{slug}/ — if the product is renamed, keep the old slug as a 301 redirect in netlify.toml.",
      "order": 2,
      "required": true,
      "type": "slug",
      "unique": true
    },
    "status": {
      "description": "live = Yayında (satışta, demo formu); pilot = Erken erişim (seçili işletmelerle, başvuru formu, ödeme yok); soon = Yakında / Planlı (bekleme listesi, ödeme yok). Payment is only taken for live products.",
      "options": [
        "live",
        "pilot",
        "soon"
      ],
      "order": 3,
      "required": true,
      "type": "select"
    },
    "status_note": {
      "description": "Optional badge text that replaces the status label, e.g. 'Aralık 2026' or 'Planlı'.",
      "max": 24,
      "order": 3.5,
      "type": "string"
    },
    "trust": {
      "items": {
        "fields": {
          "text": {
            "max": 220,
            "required": true,
            "type": "text"
          },
          "title": {
            "max": 60,
            "required": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "max": 6,
      "order": 12,
      "type": "array"
    },
    "videos": {
      "items": {
        "fields": {
          "caption": {
            "max": 200,
            "type": "text"
          },
          "poster": {
            "required": true,
            "type": "image"
          },
          "src": {
            "required": true,
            "type": "video"
          },
          "title": {
            "max": 80,
            "required": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "max": 4,
      "order": 14.6,
      "type": "array"
    }
  }
