---
import { getLegalPages } from '~/lib/legal'
import LegalPage from '~/views/LegalPage.astro'

export function getStaticPaths() {
  return getLegalPages().filter(p => p.group === 'legal').map(page => ({ params: { slug: page.slug }, props: { page } }))
}
const { page } = Astro.props
---

<LegalPage page={page} />
