---
import { getProductPages } from '~/lib/content'
import ProductPage from '~/views/ProductPage.astro'

export function getStaticPaths() {
  return getProductPages('en').map(product => ({ params: { slug: product.slug }, props: { product } }))
}
const { product } = Astro.props
---

<ProductPage product={product} locale="en" />
