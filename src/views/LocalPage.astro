---
import type { LocalPages } from '#contentrain'
import type { Locale } from '~/lib/i18n'
import Accordion from '~/components/Accordion.astro'
import Breadcrumbs from '~/components/Breadcrumbs.astro'
import CtaBlock from '~/components/CtaBlock.astro'
import Meander from '~/components/decor/Meander.astro'
import Icon from '~/components/Icon.astro'
import PageHero from '~/components/PageHero.astro'
import ProductCard from '~/components/ProductCard.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getLocalPages, getProducts, getServicePages, localPagePath, localPagePaths } from '~/lib/content'
import { localePath, routePath, ROUTES, t } from '~/lib/i18n'
import { faqSchema, localBusinessSchema, serviceSchema, webPageSchema } from '~/lib/schema'
import { breadcrumbSchema, clampDescription, SITE_NAME } from '~/lib/seo'
import { stagger } from '~/lib/ui'

interface Props { page: LocalPages, locale: Locale }
const { page, locale } = Astro.props
const s = t(locale)
const path = localPagePath(page.slug)
const paths = localPagePaths(page.id)
const title = page.meta_title || `${page.title} | ${SITE_NAME}`
const description = clampDescription(page.meta_description || page.hero_text)
const areas = page.area_served ?? []

const refId = (r: unknown) => (typeof r === 'string' ? r : (r as { id: string }).id)
const allServices = getServicePages(locale)
const services = (page.services ?? []).map(r => allServices.find(sp => sp.id === refId(r))).filter(Boolean) as typeof allServices
const products = getProducts(locale)
const others = getLocalPages(locale).filter(p => p.id !== page.id)
const faq = (page.faq ?? []).map((f, i) => ({ id: `faq-${i}`, ...f }))

const trail = [
  { name: s('nav.home'), path: '/' },
  { name: page.title, path },
]
const jsonLd = [
  webPageSchema(locale, path, title, description),
  page.local_business
    ? localBusinessSchema(locale, { name: page.title, description, path, areaServed: areas })
    : serviceSchema(locale, { title: page.title, description, path, areaServed: areas }),
  ...(faq.length ? [faqSchema(faq)] : []),
  breadcrumbSchema(locale, trail),
]
---

<BaseLayout locale={locale} title={title} description={description} path={path} paths={paths} ogTitle={page.title} jsonLd={jsonLd} contentGroup="local">
  <PageHero>
    <Breadcrumbs locale={locale} trail={trail} />
    <h1 class="page-title">{page.hero_title}</h1>
    <p class="mt-6 max-w-3xl font-inter text-lg leading-relaxed lg:text-xl">{page.hero_text}</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href={routePath('contact', locale)} class="btn btn-danger btn-lg" data-track="cta_click" data-track-cta_name="local_contact">{s('common.contact_us')}</a>
      <a href={localePath(ROUTES.products[locale], locale)} class="btn btn-outline btn-lg">{s('products.title')}</a>
    </div>
  </PageHero>

  {page.facts?.length
? (
    <section class="py-14 lg:py-20" aria-label={page.title}>
      <div class="container-x">
        <ul role="list" class="grid gap-6 md:grid-cols-3">
          {page.facts.map((f, i) => (
            <li class="reveal rounded-2xl border border-border-color bg-white p-6 lg:p-8" style={stagger(i)}>
              <h2 class="mb-3 font-space text-lg font-bold text-heading-text">{f.title}</h2>
              <p class="font-inter text-sm leading-relaxed">{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
: null}

  {(page.sections ?? []).map((sec, i) => (
    <section class:list={['py-14 lg:py-20', i % 2 === 0 && 'bg-secondary-50']} aria-labelledby={`sec-${i}`}>
      <div class="container-x"><div class="reveal max-w-4xl">
        <h2 id={`sec-${i}`} class="block-title mb-6">{sec.title}</h2>
        <p class="whitespace-pre-line font-inter leading-relaxed">{sec.body}</p>
      </div></div>
    </section>
  ))}

  {services.length > 0 && (
    <section class="py-14 lg:py-20" aria-labelledby="local-services">
      <div class="container-x">
        <h2 id="local-services" class="block-title mb-8">{s('local.services_title')}</h2>
        <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((sp, i) => (
            <li class="reveal" style={stagger(i, 60)}>
              <a href={localePath(`/services/${sp.slug}`, locale)} class="group flex h-full items-start justify-between gap-4 rounded-2xl border border-border-color bg-white p-6 transition-colors hover:border-primary-500">
                <span class="font-space font-medium text-heading-text group-hover:text-primary-600">{sp.title}</span>
                <Icon name="ri-arrow-right-up-line" class="shrink-0 text-xl text-primary-600" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="relative isolate bg-secondary-50 py-14 lg:py-20" aria-labelledby="local-products">
    <Meander class="absolute inset-x-0 top-0" />
    <div class="container-x">
      <h2 id="local-products" class="block-title mb-3">{s('products.title')}</h2>
      <p class="mb-8 max-w-2xl font-inter">{s('local.products_text')}</p>
      <ul role="list" class="grid gap-6 md:grid-cols-3">
        {products.map((product, i) => <li style={stagger(i)}><ProductCard product={product} locale={locale} /></li>)}
      </ul>
    </div>
  </section>

  {areas.length > 0 && (
    <section class="py-14 lg:py-20" aria-labelledby="local-areas">
      <div class="container-x"><div class="max-w-4xl">
        <h2 id="local-areas" class="block-title mb-6">{s('local.areas_title')}</h2>
        <ul role="list" class="flex flex-wrap gap-3">
          {areas.map(a => <li><span class="tag tag-primary">{a}</span></li>)}
        </ul>
      </div></div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="bg-secondary-50 py-14 lg:py-20" aria-labelledby="local-faq">
      <div class="container-x"><div class="max-w-4xl">
        <h2 id="local-faq" class="block-title mb-8">{s('product.faq.title')}</h2>
        <Accordion items={faq} />
      </div></div>
    </section>
  )}

  {others.length > 0 && (
    <nav class="py-14" aria-labelledby="local-others">
      <div class="container-x"><div class="max-w-4xl">
        <h2 id="local-others" class="mb-4 font-space text-lg font-bold text-heading-text">{s('local.other_regions')}</h2>
        <ul role="list" class="flex flex-wrap gap-x-8 gap-y-3">
          {others.map(o => <li><a href={localePath(localPagePath(o.slug), locale)} class="font-medium text-primary-600 hover:underline">{o.title}</a></li>)}
        </ul>
      </div></div>
    </nav>
  )}

  <CtaBlock title={s('common.cta_title')} text={s('service.cta_text')} href={routePath('contact', locale)} label={s('common.contact_us')} />
</BaseLayout>
