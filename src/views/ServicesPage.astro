---
import type { Locale } from '~/lib/i18n'
import AppCard from '~/components/AppCard.astro'
import Breadcrumbs from '~/components/Breadcrumbs.astro'
import CtaBlock from '~/components/CtaBlock.astro'
import PageHero from '~/components/PageHero.astro'
import TabSection from '~/components/TabSection.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getHome } from '~/lib/content'
import { contentLink, routePath, ROUTES, t } from '~/lib/i18n'
import { serviceSchema, webPageSchema } from '~/lib/schema'
import { breadcrumbSchema, clampDescription, SITE_NAME } from '~/lib/seo'
import { stagger } from '~/lib/ui'

interface Props { locale: Locale }
const { locale } = Astro.props
const s = t(locale)
const home = getHome(locale)
const path = ROUTES.services[locale]
const title = s('services.page_title')
const description = clampDescription(s('services.page_description'))
const services = home.services.map(sv => ({ ...sv, link: sv.link ? contentLink(sv.link, locale) : undefined }))
const trail = [{ name: s('nav.home'), path: '/' }, { name: s('nav.services'), path }]
const jsonLd = [
  { ...webPageSchema(locale, path, title, description, 'CollectionPage'), hasPart: home.services.map(sv => serviceSchema(locale, { title: sv.title, description: sv.description, path: sv.link })) },
  breadcrumbSchema(locale, trail),
]
---

<BaseLayout locale={locale} title={`${title} | ${SITE_NAME}`} description={description} path={path} paths={ROUTES.services} jsonLd={jsonLd}>
  <PageHero>
    <Breadcrumbs locale={locale} trail={trail} />
    <h1 class="page-title">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg">{s('services.page_description')}</p>
  </PageHero>

  <section class="py-12 lg:py-20" aria-label={title}>
    <div class="container-x">
      <ul role="list" class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {services.map((item, i) => (
          <li style={stagger(i % 2)}><AppCard locale={locale} item={item} view="grid" closePadding /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-secondary-50 py-20 lg:py-28" aria-labelledby="tech-title">
    <div class="container-x">
      <h2 id="tech-title" class="section-title">{s('services.technologies_title')}</h2>
      <p class="mt-3 max-w-2xl text-body-text">{s('services.technologies_text')}</p>
      <div class="mt-10 rounded-2xl border border-border-color bg-white p-6">
        <TabSection locale={locale} items={home.tabItems} categories={home.workCategories} />
      </div>
    </div>
  </section>

  <CtaBlock title={s('common.cta_title')} text={s('service.cta_text')} href={routePath('contact', locale)} label={s('common.contact_us')} />
</BaseLayout>
