---
import type { Locale } from '~/lib/i18n'
import Breadcrumbs from '~/components/Breadcrumbs.astro'
import PageHero from '~/components/PageHero.astro'
import ProductCard from '~/components/ProductCard.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getProductPages, getProducts, PRODUCT_GROUPS, productPath } from '~/lib/content'
import { ROUTES, t } from '~/lib/i18n'
import { ORG_ID, webPageSchema } from '~/lib/schema'
import { absoluteUrl, breadcrumbSchema, clampDescription, SITE_NAME } from '~/lib/seo'
import { stagger } from '~/lib/ui'

interface Props { locale: Locale }
const { locale } = Astro.props
const path = ROUTES.products[locale]
const s = t(locale)
const catalog = getProducts(locale)
const products = getProductPages(locale)
const groups = PRODUCT_GROUPS.map(g => ({ key: g, entries: catalog.filter(p => (p.group ?? 'isletme') === g) })).filter(g => g.entries.length)
const title = s('products.title')
const description = clampDescription(s('products.description'))
const trail = [{ name: s('nav.home'), path: '/' }, { name: title, path }]
const jsonLd = [
  {
    ...webPageSchema(locale, path, title, description, 'CollectionPage'),
    about: { '@id': ORG_ID },
    mainEntity: {
      '@type': 'ItemList',
      'itemListElement': products.map((p, i) => ({ '@type': 'ListItem', 'position': i + 1, 'name': p.name, 'url': absoluteUrl(productPath(p.slug, locale), locale) })),
    },
  },
  breadcrumbSchema(locale, trail),
]
---

<BaseLayout locale={locale} title={`${title} | ${SITE_NAME}`} description={description} path={path} paths={ROUTES.products} jsonLd={jsonLd}>
  <PageHero>
    <Breadcrumbs locale={locale} trail={trail} />
    <h1 class="page-title">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg">{s('products.description')}</p>
  </PageHero>
  {groups.map((g, gi) => (
    <section class:list={['py-12 lg:py-20', gi % 2 === 1 && 'bg-secondary-50']} aria-labelledby={`group-${g.key}`}>
      <div class="container-x">
        <div class="max-w-2xl">
          <h2 id={`group-${g.key}`} class="section-title">{s(`products.group.${g.key}.title`)}</h2>
          <p class="mt-3 text-lg text-body-text">{s(`products.group.${g.key}.text`)}</p>
        </div>
        <ul role="list" class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {g.entries.map((product, i) => <li style={stagger(i)}><ProductCard product={product} locale={locale} /></li>)}
        </ul>
      </div>
    </section>
  ))}
</BaseLayout>
