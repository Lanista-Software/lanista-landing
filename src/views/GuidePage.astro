---
/**
 * One guide article: short answer, table of contents, body, FAQ, sources and a
 * call to the related solution page. A reading-progress bar runs on scroll
 * (CSS scroll timeline; static under prefers-reduced-motion).
 */
import type { Guide } from '~/lib/guides'
import Accordion from '~/components/Accordion.astro'
import Breadcrumbs from '~/components/Breadcrumbs.astro'
import GuideCard from '~/components/GuideCard.astro'
import Icon from '~/components/Icon.astro'
import Img from '~/components/Img.astro'
import PageHero from '~/components/PageHero.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getSolutionPages } from '~/lib/content'
import { formatDate, getGuides, guidePath, GUIDES_PATH, renderGuide } from '~/lib/guides'
import { t } from '~/lib/i18n'
import { faqSchema, ORG_ID, webPageSchema } from '~/lib/schema'
import { absoluteAsset, absoluteUrl, breadcrumbSchema, clampDescription, SITE_NAME } from '~/lib/seo'

interface Props { guide: Guide }
const { guide } = Astro.props
const locale = 'tr'
const s = t(locale)
const path = guidePath(guide.slug)
const title = guide.meta_title || `${guide.title} | ${SITE_NAME}`
const description = clampDescription(guide.description)
const { html, toc } = renderGuide(guide)
const faq = (guide.faq ?? []).map((f, i) => ({ id: `faq-${i}`, ...f }))
const others = getGuides().filter(g => g.id !== guide.id).slice(0, 3)
const refId = (r: unknown) => (typeof r === 'string' ? r : (r as { id: string } | undefined)?.id)
const solution = getSolutionPages().find(p => p.id === refId(guide.related_solution))
const ctaHref = solution ? `/${solution.slug}/#teklif` : '/iletisim/'

const trail = [
  { name: s('nav.home'), path: '/' },
  { name: s('guides.title'), path: GUIDES_PATH },
  { name: guide.title, path },
]
const jsonLd = [
  webPageSchema(locale, path, title, description),
  {
    '@type': 'Article',
    '@id': `${absoluteUrl(path)}#article`,
    'headline': guide.title,
    'description': description,
    'inLanguage': 'tr-TR',
    'datePublished': guide.published_at,
    'dateModified': guide.checked_at || guide.published_at,
    'author': { '@id': ORG_ID },
    'publisher': { '@id': ORG_ID },
    'mainEntityOfPage': { '@id': `${absoluteUrl(path)}#webpage` },
    ...(guide.cover ? { image: absoluteAsset(guide.cover) } : {}),
    ...(guide.sources?.length ? { citation: guide.sources.map(src => src.url) } : {}),
  },
  ...(faq.length ? [faqSchema(faq)] : []),
  breadcrumbSchema(locale, trail),
]
---

<BaseLayout locale={locale} locales={['tr']} title={title} description={description} path={path} ogTitle={guide.title} type="article" jsonLd={jsonLd} contentGroup="guide">
  <div class="reading-progress" aria-hidden="true"></div>

  <PageHero>
    <Breadcrumbs locale={locale} trail={trail} />
    <h1 class="page-title">{guide.title}</h1>
    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-label-text">
      <span>{s('guides.published', { date: formatDate(guide.published_at)! })}</span>
      {guide.checked_at && <span class="inline-flex items-center gap-1"><Icon name="ri-shield-check-line" class="text-primary-600" />{s('guides.checked', { date: formatDate(guide.checked_at)! })}</span>}
    </p>
  </PageHero>

  <div class="container-x grid gap-12 pb-20 pt-4 lg:grid-cols-[16rem_minmax(0,1fr)]">
    {toc.length > 2 && (
      <nav aria-labelledby="toc-title" class="lg:sticky lg:top-28 lg:self-start">
        <h2 id="toc-title" class="text-sm font-semibold text-label-text">{s('legal.toc')}</h2>
        <ol class="mt-3 space-y-2 border-l border-border-color pl-4 text-sm">
          {toc.map(item => <li><a href={`#${item.id}`} class="text-body-text hover:text-primary-600">{item.text}</a></li>)}
        </ol>
      </nav>
    )}

    <article class="max-w-3xl">
      {guide.cover && <Img src={guide.cover} alt="" width={640} height={320} priority class="mb-8 aspect-[2/1] w-full rounded-2xl border border-border-color bg-white object-contain" />}

      {guide.summary && (
        <aside class="mb-10 rounded-2xl border border-primary-200 bg-primary-50 p-6" aria-labelledby="guide-summary">
          <h2 id="guide-summary" class="mb-2 font-space text-base font-bold text-primary-700">{s('guides.summary')}</h2>
          <p class="font-inter leading-relaxed text-heading-text">{guide.summary}</p>
        </aside>
      )}

      <div class="guide-prose prose prose-slate max-w-none prose-headings:scroll-mt-28 prose-headings:font-space prose-headings:text-heading-text prose-a:text-primary-600 prose-table:text-sm prose-th:bg-secondary-50 prose-th:px-3 prose-td:px-3" set:html={html} />

      {faq.length > 0 && (
        <section class="mt-14" aria-labelledby="guide-faq">
          <h2 id="guide-faq" class="block-title mb-6">{s('product.faq.title')}</h2>
          <Accordion items={faq} />
        </section>
      )}

      {guide.sources?.length
        ? (
          <section class="mt-14 rounded-2xl border border-border-color p-6" aria-labelledby="guide-sources">
            <h2 id="guide-sources" class="font-space text-lg font-bold text-heading-text">{s('guides.sources')}</h2>
            <p class="mt-1 text-sm text-label-text">{s('guides.sources_note')}</p>
            <ul class="mt-4 space-y-2 text-sm">
              {guide.sources.map(src => <li><a href={src.url} class="link" target="_blank" rel="noopener">{src.title}<span class="sr-only"> {s('a11y.opens_new_tab')}</span></a></li>)}
            </ul>
            <p class="mt-4 text-xs text-label-text">{s('guides.disclaimer')}</p>
          </section>
        )
        : null}

      <aside class="mt-14 rounded-2xl bg-primary-800 p-8 text-white" aria-labelledby="guide-cta">
        <h2 id="guide-cta" class="font-space text-2xl font-bold">{s('guides.cta_title')}</h2>
        <p class="mt-3 max-w-xl text-primary-100">{s('guides.cta_text')}</p>
        <a href={ctaHref} class="btn btn-danger mt-6" data-track="cta_click" data-track-cta_name="guide_cta" data-track-product={guide.slug}>{s('guides.cta_button')}</a>
      </aside>
    </article>
  </div>

  {others.length > 0 && (
    <section class="bg-secondary-50 py-16 lg:py-20" aria-labelledby="guide-others">
      <div class="container-x">
        <h2 id="guide-others" class="block-title mb-8">{s('guides.related')}</h2>
        <ul role="list" class="grid gap-6 md:grid-cols-3">
          {others.map(g => <li><GuideCard guide={g} headingLevel="h3" /></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: 3px;
    background: theme('colors.danger.600');
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        animation: reading-progress linear both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @supports not (animation-timeline: scroll()) {
    .reading-progress { display: none; }
  }
  @keyframes reading-progress { to { transform: scaleX(1); } }
  .guide-prose :global(table) { display: block; overflow-x: auto; }
</style>
