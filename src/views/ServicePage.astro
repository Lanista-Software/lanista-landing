---
import type { Locale } from '~/lib/i18n'
import Breadcrumbs from '~/components/Breadcrumbs.astro'
import CtaBlock from '~/components/CtaBlock.astro'
import Icon from '~/components/Icon.astro'
import PageHero from '~/components/PageHero.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getServicePage, splitList } from '~/lib/content'
import { localePath, routePath, ROUTES, t } from '~/lib/i18n'
import { serviceSchema } from '~/lib/schema'
import { breadcrumbSchema, clampDescription, SITE_NAME } from '~/lib/seo'
import { stagger } from '~/lib/ui'


const { locale, slug } = Astro.props as { locale: Locale, slug: string }
const s = t(locale)
const { page, otherPages, relatedWorks } = getServicePage(locale, slug)!
const technologies = splitList(page.technologies)
const trail = [
  { name: s('nav.home'), path: '/' },
  { name: s('nav.services'), path: ROUTES.services[locale] },
  { name: page.title, path: `/services/${slug}` },
]
const blocks = [
  { key: 'challenge', title: s('common.challenge'), body: page.challenge_content, alt: false },
  { key: 'approach', title: s('service.approach'), body: page.approach_content, alt: true },
]
---

<BaseLayout
  locale={locale}
  title={page.meta_title ?? `${page.title} | ${SITE_NAME}`}
  description={clampDescription(page.meta_description)}
  ogTitle={page.title}
  path={`/services/${slug}`}
  jsonLd={[serviceSchema(locale, { title: page.title, description: page.meta_description, path: `/services/${slug}` }), breadcrumbSchema(locale, trail)]}
>
  <PageHero>
    <Breadcrumbs locale={locale} trail={trail} />
    <h1 class="page-title">{page.title}</h1>
    <p class="mt-6 font-inter text-lg leading-relaxed lg:text-xl">{page.hero_description}</p>
  </PageHero>

  {blocks.filter(b => b.body).map(b => (
    <section class:list={['py-16 lg:py-20', b.alt && 'bg-secondary-50']} aria-labelledby={`${b.key}-title`}>
      <div class="container-x"><div class="reveal max-w-4xl">
        <h2 id={`${b.key}-title`} class="block-title mb-6">{b.title}</h2>
        <p class="whitespace-pre-line font-inter leading-relaxed">{b.body}</p>
      </div></div>
    </section>
  ))}

  {technologies.length > 0 && (
    <section class="py-16 lg:py-20" aria-labelledby="tech-title">
      <div class="container-x"><div class="max-w-4xl">
        <h2 id="tech-title" class="block-title mb-6">{s('service.technologies')}</h2>
        <ul role="list" class="flex flex-wrap gap-3">
          {technologies.map((tech, i) => <li class="reveal" style={stagger(i, 40)}><span class="tag tag-primary">{tech}</span></li>)}
        </ul>
      </div></div>
    </section>
  )}

  {page.benefits_content && (
    <section class="bg-secondary-50 py-16 lg:py-20" aria-labelledby="benefits-title">
      <div class="container-x"><div class="reveal max-w-4xl">
        <h2 id="benefits-title" class="block-title mb-6">{s('service.benefits')}</h2>
        <p class="whitespace-pre-line font-inter leading-relaxed">{page.benefits_content}</p>
      </div></div>
    </section>
  )}

  {relatedWorks.length > 0 && (
    <section class="py-16 lg:py-20" aria-labelledby="related-title">
      <div class="container-x"><div class="max-w-4xl">
        <h2 id="related-title" class="block-title mb-8">{s('service.related')}</h2>
        <ul role="list" class="space-y-6">
          {relatedWorks.map((work, i) => (
            <li class="reveal rounded-2xl border border-border-color p-6 lg:p-8" style={stagger(i)}>
              {work.categoryName && <span class="tag tag-primary tag-lg mb-3">{work.categoryName}</span>}
              <h3 class="mb-2 font-space text-xl font-bold text-heading-text">{work.title}</h3>
              <p class="line-clamp-3 font-inter leading-relaxed">{work.description}</p>
              <div class="mt-4 flex flex-wrap gap-4">
                {work.slug && <a href={localePath(`/works/${work.slug}`, locale)} class="link inline-flex items-center gap-1 text-sm">{s('common.case_study')}<span class="sr-only">: {work.title}</span><Icon name="ri-arrow-right-line" /></a>}
                {work.link && <a href={work.link} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1 text-sm">{s('common.view_project')}<span class="sr-only">: {work.title} {s('a11y.opens_new_tab')}</span><Icon name="ri-arrow-right-up-line" /></a>}
              </div>
            </li>
          ))}
        </ul>
      </div></div>
    </section>
  )}

  <section class="bg-secondary-50 py-16 lg:py-20" aria-labelledby="other-title">
    <div class="container-x"><div class="max-w-4xl">
      <h2 id="other-title" class="block-title mb-8">{s('service.others')}</h2>
      <ul role="list" class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {otherPages.map((other, i) => (
          <li class="reveal" style={stagger(i % 4)}>
            <a href={localePath(`/services/${other.slug}`, locale)} class="card-lift block h-full rounded-xl border border-border-color bg-white p-5">
              <h3 class="font-space text-lg font-bold text-heading-text">{other.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm">{other.hero_description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div></div>
  </section>

  <CtaBlock title={s('common.cta_title')} text={s('service.cta_text')} href={routePath('contact', locale)} label={s('common.contact_us')} />
</BaseLayout>
