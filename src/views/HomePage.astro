---
import type { Locale } from '~/lib/i18n'
import Accordion from '~/components/Accordion.astro'
import AppCard from '~/components/AppCard.astro'
import Amphitheatre from '~/components/decor/Amphitheatre.astro'
import Hero from '~/components/Hero.astro'
import Icon from '~/components/Icon.astro'
import Img from '~/components/Img.astro'
import ProductCard from '~/components/ProductCard.astro'
import Section from '~/components/Section.astro'
import SectionLayout from '~/components/SectionLayout.astro'
import TestimonialCard from '~/components/TestimonialCard.astro'
import WorksCard from '~/components/WorksCard.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { COMPANY } from '~/lib/company'
import { getHome, getLayout, getOnboardingSteps, getProduct, getProductPages, getTeam, productPath } from '~/lib/content'
import { contentLink, localePath, routePath, t } from '~/lib/i18n'
import { creativeWorkSchema, faqSchema, organizationSchema, serviceSchema, teamSchema, webPageSchema, websiteSchema } from '~/lib/schema'
import { clampDescription, SITE_NAME } from '~/lib/seo'
import { stagger } from '~/lib/ui'


const { locale } = Astro.props as { locale: Locale }
const s = t(locale)
const home = getHome(locale)
const { socialLinks } = getLayout(locale)
const section = home.section
const link = (name: string) => contentLink(section(name).buttonlink, locale)

// Home shows the six services with real Turkish search demand (docs/kararlar-arama-verisi.md).
const services = home.services.filter(sv => sv.on_home).map(sv => ({ ...sv, link: sv.link ? contentLink(sv.link, locale) : undefined }))
const previewWorks = home.works.slice(0, 3)
// Turkish home leads with the products; English stays agency-first (products are Turkey-only).
// Home shows the products on sale now; the full catalogue is one click away.
const products = getProductPages(locale).filter(p => p.status === 'live')
const flagship = getProduct('yedek-parca', locale)
const steps = getOnboardingSteps(locale)

const meta = home.metaTags
const title = meta.title || SITE_NAME
const description = clampDescription(meta.description)
const jsonLd = [
  webPageSchema(locale, '/', title, description),
  websiteSchema(),
  organizationSchema(socialLinks.map(l => l.link)),
  ...home.services.map(sv => serviceSchema(locale, { title: sv.title, description: sv.description, path: sv.link })),
  faqSchema(home.faq),
  ...home.works.filter(w => w.slug).map(w => creativeWorkSchema(locale, w)),
  ...teamSchema(getTeam(locale)),
]
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path="/"
  ogTitle={meta.ogTitle || title}
  ogDescription={clampDescription(meta.ogDescription || meta.description)}
  jsonLd={jsonLd}
>
  <div id="home" data-spy-section class="hero-bg relative isolate overflow-hidden">
    <Amphitheatre />
    <div class="container-x flex items-center justify-center pb-24 pt-16 lg:pb-32 lg:pt-20">
      <Hero
        hero={section('hero')}
        buttonHref={link('hero')}
        secondary={{ label: s('home.hero_secondary_cta'), href: `${localePath(productPath('yedek-parca', locale), locale)}#demo` }}
        visualLabel={s('home.hero_visual_label')}
        screenshot={flagship?.hero_screenshot}
        chip={{ title: s('home.hero_chip_title'), text: s('home.hero_chip_text') }}
      />
    </div>
  </div>


  {products.length > 0 && (
    <Section id="urunler" spy labelledby="products-title">
      <SectionLayout id="products-title" title={section('products').title} description={section('products').description}>
        <ul role="list" class="grid w-full grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-4">
          {products.map((product, i) => <li style={stagger(i)}><ProductCard product={product} locale={locale} /></li>)}
        </ul>
        <a slot="button" href={contentLink(section('products').buttonlink, locale)} class="link inline-flex items-center gap-1 text-lg">
          {section('products').buttontext}<Icon name="ri-arrow-right-line" />
        </a>
      </SectionLayout>
    </Section>
  )}

  {steps.length > 0 && (
    <section id="baslarken" aria-labelledby="start-title" class="bg-secondary-50">
      <div class="container-x py-24 lg:py-32">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <h2 id="start-title" class="section-title">{section('start').title}</h2>
            <p class="mt-4 text-lg text-body-text">{section('start').description}</p>
            <ol class="mt-10 space-y-8">
              {steps.map((step, i) => (
                <li class="reveal flex gap-5" style={stagger(i, 120)}>
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-full border-2 border-primary-800 bg-white font-space text-lg font-bold text-primary-800" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3 class="font-space text-xl font-bold text-heading-text">{step.title}</h3>
                    <p class="mt-1 text-body-text">{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
            <a href={contentLink(section('start').buttonlink, locale)} class="btn btn-danger btn-lg mt-10">{section('start').buttontext}</a>
          </div>
          {flagship?.trust?.length
? (
            <ul role="list" class="grid content-start gap-4 sm:grid-cols-2">
              {flagship.trust.map((item, i) => (
                <li class="reveal rounded-2xl border border-border-color bg-white p-6" style={stagger(i)}>
                  <h3 class="font-space text-lg font-bold text-heading-text">{item.title}</h3>
                  <p class="mt-2 text-sm text-body-text">{item.text}</p>
                </li>
              ))}
            </ul>
          )
: null}
        </div>
      </div>
    </section>
  )}

  <section id="ekip" aria-labelledby="bridge-title">
    <div class="container-x py-24 lg:py-28">
      <div class="reveal mx-auto max-w-3xl text-center">
        <h2 id="bridge-title" class="section-title text-balance">{section('bridge').title}</h2>
        <p class="mt-5 text-lg text-body-text">{section('bridge').description}</p>
        <a href={contentLink(section('bridge').buttonlink, locale)} class="btn btn-outline btn-lg mt-8">{section('bridge').buttontext}</a>
      </div>
    </div>
  </section>

  <Section id="services" spy labelledby="services-title">
    <SectionLayout id="services-title" title={section('services').title} description={section('services').description}>
      <ul role="list" class="grid w-full grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-4">
        {services.slice(0, 3).map((item, i) => (
          <li style={stagger(i)}>
            <AppCard locale={locale} item={item} view="triple" closePadding />
          </li>
        ))}
      </ul>
      <a slot="button" href={routePath('services', locale)} class="btn btn-outline" data-track="cta_click" data-track-cta_name="home_services">
        {s('home.services_more')}<Icon name="ri-arrow-right-line" />
      </a>
    </SectionLayout>
  </Section>

  <Section id="process" spy labelledby="process-title">
    <SectionLayout id="process-title" title={section('process').title} description={section('process').description}>
      <!-- Compact strip on the home page; the full illustrated steps live on the process page. -->
      <ol class="grid w-full grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border-color bg-border-color sm:grid-cols-3 lg:grid-cols-6">
        {home.processes.map((item, i) => (
          <li class="reveal flex flex-col gap-3 bg-white p-5" style={stagger(i, 60)}>
            <span class="font-space text-sm font-semibold text-primary-600" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-space text-base font-bold leading-snug text-heading-text">{item.title}</span>
          </li>
        ))}
      </ol>
      <a slot="button" href={routePath('process', locale)} class="btn btn-outline" data-track="cta_click" data-track-cta_name="home_process">
        {s('home.process_more')}<Icon name="ri-arrow-right-line" />
      </a>
    </SectionLayout>
  </Section>

  <Section id="works" spy labelledby="works-title">
    <SectionLayout id="works-title" title={section('works').title} description={section('works').description}>
      <ul role="list" aria-label={s('a11y.references')} class="mb-16 flex w-full flex-wrap items-center justify-center gap-x-10 gap-y-8">
        {home.references.map(r => <li><Img src={r.logo} alt={r.name} class="h-7 w-auto" height={28} width={120} /></li>)}
      </ul>
      <ul role="list" class="grid w-full grid-cols-1 gap-8">
        {previewWorks.map((item, i) => <li style={stagger(i)}><WorksCard locale={locale} item={item} /></li>)}
      </ul>
      <a slot="button" href={localePath('/works', locale)} class="link inline-flex items-center gap-1 text-lg">
        {section('works').buttontext || s('common.view_all_work')}<Icon name="ri-arrow-right-line" />
      </a>
    </SectionLayout>
  </Section>

  <Section id="testimonials" labelledby="testimonials-title">
    <SectionLayout id="testimonials-title" title={section('testimonials').title} description={section('testimonials').description}>
      <ul role="list" class="grid w-full grid-cols-1 gap-8 lg:grid-cols-6">
        {home.testimonials.map((item, i) => <li class="lg:col-span-2" style={stagger(i)}><TestimonialCard item={item} /></li>)}
      </ul>
    </SectionLayout>
  </Section>


  <section id="sss" aria-labelledby="faq-title" class="bg-secondary-50">
    <div class="container-x flex items-center justify-center py-20 lg:py-28">
      <div class="w-full space-y-16 lg:flex lg:justify-between lg:gap-16 lg:space-y-0 2xl:gap-24">
        <div class="flex-1">
          <h2 id="faq-title" class="section-title">{section('faq').title}</h2>
          <p class="mt-4 font-inter text-base font-normal text-body-text">{section('faq').description}</p>
          <div class="pt-8">
            <Accordion items={home.faq} />
          </div>
        </div>
        <div class="flex-1">
          <div class="reveal rounded-2xl border border-border-color bg-white p-8 lg:p-10">
            <h2 class="section-title" id="contact-title">{s('home.contact_cta_title')}</h2>
            <p class="mt-4 font-inter text-base text-body-text">{s('home.contact_cta_text')}</p>
            <dl class="mt-8 space-y-3">
              <div class="flex gap-3"><dt class="w-24 shrink-0 text-sm text-label-text">{s('form.label.phone')}</dt><dd><a class="link" href={COMPANY.phoneHref}>{COMPANY.phone}</a></dd></div>
              <div class="flex gap-3"><dt class="w-24 shrink-0 text-sm text-label-text">{s('form.label.email')}</dt><dd><a class="link" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd></div>
              <div class="flex gap-3"><dt class="w-24 shrink-0 text-sm text-label-text">{s('company.address')}</dt><dd class="text-heading-text">{COMPANY.address.full}</dd></div>
            </dl>
            <a href={routePath('contact', locale)} class="btn btn-danger mt-8">{s('contact.form_title')}<Icon name="ri-arrow-right-line" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
