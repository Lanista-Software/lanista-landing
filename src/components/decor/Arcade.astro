---
/** A row of arches (arcade) — texture for dark banners. Decorative. */
interface Props { class?: string }
const { class: className } = Astro.props
const arches = Array.from({ length: 9 }, (_, i) => i)
---

<div class:list={['decor pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <svg class="absolute bottom-0 left-1/2 h-full w-[1400px] max-w-none -translate-x-1/2" viewBox="0 0 1400 420" preserveAspectRatio="xMidYMax slice" fill="none" stroke="#FFFFFF" stroke-opacity="0.1" stroke-width="1.25">
    <g data-parallax="0.08">
      {arches.map((i) => {
        const x = 40 + i * 150
        return (
          <>
            <path d={`M${x} 420 V200 A65 65 0 0 1 ${x + 130} 200 V420`} />
            <path d={`M${x + 18} 420 V204 A47 47 0 0 1 ${x + 112} 204 V420`} stroke-opacity="0.06" />
            <line x1={x - 8} y1="196" x2={x + 138} y2="196" />
          </>
        )
      })}
      <line x1="0" y1="120" x2="1400" y2="120" />
      <line x1="0" y1="112" x2="1400" y2="112" stroke-opacity="0.05" />
    </g>
  </svg>
</div>
