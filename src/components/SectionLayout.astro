---
interface Props {
  id: string
  title?: string
  description?: string
}
const { id, title, description } = Astro.props
const hasButton = Astro.slots.has('button')
---

<div class="w-full">
  <div class="w-full pb-16 lg:flex lg:justify-between lg:gap-8">
    <h2 id={id} class="section-title mb-4 lg:w-1/2">{title}</h2>
    {description && <p class="text-lg text-body-text lg:w-1/2">{description}</p>}
  </div>
  <slot />
  {hasButton && (
    <div class="flex items-center justify-center pt-16">
      <slot name="button" />
    </div>
  )}
</div>
