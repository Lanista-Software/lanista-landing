---
import HeroVisual from '~/components/HeroVisual.astro'

interface Props {
  hero: { title?: string, subtitle?: string, description?: string, buttontext?: string }
  buttonHref: string
  secondary?: { label: string, href: string }
  visualLabel: string
  screenshot?: string
  chip?: { title: string, text: string }
}
const { hero, buttonHref, secondary, visualLabel, screenshot, chip } = Astro.props
---

{hero.title && (
  <div class="grid w-full items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-8">
    <div class="hero-copy max-w-xl text-center lg:text-left">
      {hero.subtitle && <p><span class="tag tag-secondary tag-lg">{hero.subtitle}</span></p>}
      <h1 class="mt-6 font-space text-4xl font-semibold leading-[1.08] text-heading-text md:text-5xl xl:text-[3.5rem]">{hero.title}</h1>
      <p class="mt-6 text-lg font-normal text-body-text md:text-xl">{hero.description}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
        <a href={buttonHref} class="btn btn-danger btn-lg" data-track="button_clicked" data-track-button_name="hero_primary">
          {hero.buttontext}
          <i class="ri-arrow-right-line" aria-hidden="true"></i>
        </a>
        {secondary && (
          <a href={secondary.href} class="btn btn-outline btn-lg" data-track="button_clicked" data-track-button_name="hero_secondary">{secondary.label}</a>
        )}
      </div>
    </div>
    <HeroVisual label={visualLabel} screenshot={screenshot} chip={chip} />
  </div>
)}
