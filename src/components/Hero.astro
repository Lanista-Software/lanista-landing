---
import Img from '~/components/Img.astro'

interface Props {
  hero: { title?: string, subtitle?: string, description?: string, buttontext?: string }
  buttonHref: string
  references: { id: string, logo: string, name: string }[]
}
const { hero, buttonHref, references } = Astro.props
---

{hero.title && (
  <div class="hero-section relative flex max-w-screen-lg flex-col justify-center text-center">
    {hero.subtitle && <p><span class="tag tag-secondary tag-lg">{hero.subtitle}</span></p>}
    <h1 class="mt-8 font-space text-4xl font-semibold text-heading-text lg:text-5xl xl:text-6xl">{hero.title}</h1>
    <p class="mt-6 text-lg font-normal text-body-text md:text-xl">{hero.description}</p>
    <div class="flex items-center justify-center pt-8">
      <a href={buttonHref} class="btn btn-danger" data-track="button_clicked" data-track-button_name="hero_button">
        {hero.buttontext}
        <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
      </a>
    </div>
    <ul role="list" class="mx-auto flex w-full max-w-screen-md flex-wrap items-center justify-evenly gap-4 gap-y-8 pt-14 lg:pt-20">
      {references.map(r => (
        <li><Img src={r.logo} alt={r.name} class="h-7 w-auto" height={28} width={120} /></li>
      ))}
    </ul>
  </div>
)}

<style>
  .hero-section {
    height: calc(100vh - 15rem);
    max-height: 1000px;
  }

  @media (min-width: 1280px) {
    .hero-section {
      height: 100%;
      padding: 4rem 0;
    }
  }
</style>
