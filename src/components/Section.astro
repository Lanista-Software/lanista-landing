---
interface Props {
  id: string
  class?: string
  /** Participates in the home-page nav scroll-spy. */
  spy?: boolean
  labelledby?: string
}
const { id, class: className, spy = false, labelledby } = Astro.props
---

<section id={id} data-spy-section={spy ? '' : undefined} aria-labelledby={labelledby} class={className}>
  <div class="container-x flex items-center justify-center py-20 lg:py-28">
    <slot />
  </div>
</section>
