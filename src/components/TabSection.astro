---
import type { Tabitems, WorkCategories } from '#contentrain'
import type { Locale } from '~/lib/i18n'
import Img from '~/components/Img.astro'
import { t } from '~/lib/i18n'

interface Props {
  locale: Locale
  items: Tabitems[]
  categories: WorkCategories[]
}
const { locale, items, categories } = Astro.props
const s = t(locale)
const catId = (item: Tabitems) => (typeof item.category === 'object' && item.category ? item.category.id : item.category)
// Only categories that have items, in category order.
const tabs = categories
  .filter(c => items.some(i => catId(i) === c.id))
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
const first = tabs[0]?.id
---

<!-- Zag.js tabs: roving tabindex, arrow/Home/End keys, aria-selected/controls. -->
{tabs.length > 0 && (
  <div data-tabs data-default-value={first} class="w-full">
    <div data-part="list" role="tablist" class="relative flex justify-start overflow-x-auto after:absolute after:bottom-0 after:left-0 after:z-10 after:inline-block after:h-0.5 after:w-full after:rounded-full after:bg-secondary-300 md:justify-center">
      {tabs.map(cat => (
        <button
          type="button"
          role="tab"
          data-part="trigger"
          data-value={cat.id}
          aria-selected={cat.id === first ? 'true' : 'false'}
          class="relative shrink-0 whitespace-nowrap px-4 py-3 font-medium text-body-text transition-colors after:absolute after:bottom-0 after:left-0 after:z-20 after:inline-block after:h-0.5 after:w-full after:rounded-full after:bg-transparent after:transition-colors hover:text-heading-text aria-selected:text-heading-text aria-selected:after:bg-primary-500"
        >
          {cat.category}
        </button>
      ))}
    </div>
    {tabs.map(cat => (
      <div data-part="content" data-value={cat.id} role="tabpanel" class="tab-panel">
        <ul role="list">
          {items.filter(i => catId(i) === cat.id).map(item => (
            <li class="flex flex-col items-start justify-between gap-4 border-b border-border-color py-5 last:border-b-0 md:flex-row md:items-center md:gap-8">
              <div class="h-20 w-48">
                <Img class="size-full rounded-xl object-cover" src={item.image} width={200} height={80} />
              </div>
              <p class="flex-1 text-sm text-body-text">{item.description}</p>
              {item.link && (
                <a href={item.link} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-icon text-muted-text">
                  <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
                  <span class="sr-only">{s.moreDetailsFor} {item.link} {s.opensNewTab}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}

<script>
  import { initTabs } from '~/scripts/tabs'

  initTabs()
</script>
