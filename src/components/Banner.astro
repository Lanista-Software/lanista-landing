---
import Arcade from '~/components/decor/Arcade.astro'

interface Props {
  id: string
  title?: string
  description?: string
  buttonLabel?: string
  buttonHref: string
}
const { id, title, description, buttonLabel, buttonHref } = Astro.props
---

<div class="relative isolate w-full overflow-hidden rounded-3xl bg-custom-gradient">
  <Arcade />
  <div class="relative size-full space-y-6 rounded-3xl p-12 md:flex md:items-center md:justify-evenly md:gap-6 md:space-y-0 md:p-24 2xl:p-32">
    <div class="w-full md:w-1/2">
      <h2 id={id} class="font-space text-4xl font-semibold text-white">{title}</h2>
      <p class="mt-2 font-inter text-lg font-normal text-secondary-200">{description}</p>
    </div>
    <div class="w-full md:flex md:w-1/2 md:items-center md:justify-end">
      <a href={buttonHref} class="btn btn-danger btn-lg" data-track="button_clicked" data-track-button_name="banner">
        {buttonLabel}
        <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>
