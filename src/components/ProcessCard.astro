---
import Icon from '~/components/Icon.astro'
import Img from '~/components/Img.astro'

interface Props {
  step: number
  item: { title: string, description?: string, illustration?: string, icon?: string }
}
const { step, item } = Astro.props
---

<article class="reveal process-card group flex h-full flex-col overflow-hidden rounded-2xl border border-border-color bg-white">
  <div class="process-card__art relative border-b border-border-color bg-white">
    {item.illustration
      ? <Img src={item.illustration} alt="" width={480} height={360} class="mx-auto aspect-[4/3] w-full max-w-[360px] object-contain transition-transform duration-500 ease-out group-hover:-translate-y-1" />
      : item.icon && <div class="flex aspect-[4/3] items-center justify-center"><span class="icon-badge"><Icon name={item.icon} /></span></div>}
  </div>
  <div class="flex flex-1 flex-col gap-2 p-6">
    <!-- The list is an <ol>: assistive tech already announces the position. -->
    <p class="font-space text-sm font-semibold text-primary-600" aria-hidden="true">{String(step).padStart(2, '0')}</p>
    <h3 class="font-space text-xl font-bold text-heading-text">{item.title}</h3>
    <p class="font-inter text-body-text">{item.description}</p>
  </div>
</article>
