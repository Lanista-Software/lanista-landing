---
import type { Locale } from '~/lib/i18n'
import { getSolutionPages } from '~/lib/content'
import { localePath, ROUTES, t } from '~/lib/i18n'

interface Props {
  locale: Locale
  path: string
  direction: 'horizontal' | 'vertical'
  id?: string
}
const { locale, path, direction, id } = Astro.props
const s = t(locale)
const isHome = path === '/'

// Hash items scroll within the home page; route items are real pages.
// Solution hubs (/e-donusum/) are Turkish-only; their label is the page title.
type Item = { key: string, label?: string, href: string, route?: string, section?: string }
const solutions: Item[] = locale === 'tr' ? getSolutionPages().map(p => ({ key: p.slug, label: p.title, href: `/${p.slug}/`, route: `/${p.slug}` })) : []
const items: Item[] = [
  { key: 'home', href: localePath('/', locale), section: 'home' },
  { key: 'products', href: localePath(ROUTES.products[locale], locale), route: ROUTES.products[locale] },
  ...solutions,
  { key: 'services', href: localePath(ROUTES.services[locale], locale), route: ROUTES.services[locale] },
  { key: 'process', href: localePath(ROUTES.process[locale], locale), route: ROUTES.process[locale] },
  { key: 'works', href: localePath('/works', locale), route: '/works' },
]

function isCurrentRoute(route?: string) {
  if (!route)
    return false
  return path === route || path.startsWith(`${route}/`)
}
---

<nav aria-label={s('a11y.main_nav')} id={id}>
  <ul class:list={[direction === 'vertical' ? 'flex flex-col gap-6' : 'flex items-center gap-4 xl:gap-6']}>
    {items.map((item) => {
      const current = item.route ? isCurrentRoute(item.route) : isHome && item.section === 'home'
      return (
        <li>
          <a
            href={item.href}
            data-nav-section={item.section && isHome ? item.section : undefined}
            aria-current={current ? 'page' : undefined}
            class="font-inter font-medium text-heading-text transition-colors hover:text-danger-600 aria-[current]:font-bold aria-[current]:text-danger-600"
          >
            {item.label ?? s(`nav.${item.key}`)}
          </a>
        </li>
      )
    })}
  </ul>
</nav>
