---
/**
 * Home hero visual (Ludus style): a classical arch on a plinth framing a phone
 * that shows Hesap Takip's "Vadesi geçenler" screen with sample data.
 * Layers carry data-parallax so the motion script can separate them.
 * The phone screen is HTML (crisp text); swap in a real screenshot via `screenshot`.
 */
import Img from '~/components/Img.astro'

interface Props {
  label: string
  screenshot?: string
}
const { label, screenshot } = Astro.props
const rows = [
  { name: 'Kaya Oto Servis', amount: '₺21.400', days: 34, late: true },
  { name: 'Demir Lastik', amount: '₺14.950', days: 21, late: true },
  { name: 'Usta Kaporta', amount: '₺9.800', days: 12, late: true },
  { name: 'Yıldız Oto Elektrik', amount: '₺6.250', days: 3, late: false },
  { name: 'Aras Motor', amount: '₺4.100', days: 1, late: false },
]
---

<figure class="hero-visual relative mx-auto aspect-[5/6] w-full max-w-[520px]" role="img" aria-label={label}>
  <!-- Arch, columns, plinth (back layer) -->
  <svg class="absolute inset-0 size-full" viewBox="0 0 500 600" fill="none" aria-hidden="true" data-parallax="0.04">
    <defs>
      <pattern id="hv-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="#9ABFE5" stroke-width="1.5" />
      </pattern>
    </defs>
    <g stroke="#10273E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <!-- archivolt + piers -->
      <path d="M70 540 V250 A180 180 0 0 1 430 250 V540 H382 V250 A132 132 0 0 0 118 250 V540 Z" fill="#EBF2FA" />
      <rect x="420" y="250" width="9" height="290" fill="url(#hv-hatch)" stroke="none" />
      <rect x="60" y="242" width="70" height="14" fill="#C2D9EF" />
      <rect x="370" y="242" width="70" height="14" fill="#C2D9EF" />
      <g stroke-width="1.25">
        <line x1="133" y1="187" x2="90" y2="168" /><line x1="160" y1="150" x2="130" y2="113" />
        <line x1="199" y1="125" x2="183" y2="80" /><line x1="301" y1="125" x2="317" y2="80" />
        <line x1="340" y1="150" x2="370" y2="113" /><line x1="367" y1="187" x2="410" y2="168" />
      </g>
      <!-- keystone: the single red element -->
      <polygon points="225,63 275,63 268,120 232,120" fill="#E31F30" />
      <!-- plinth + ground -->
      <rect x="40" y="540" width="420" height="22" fill="#C2D9EF" />
      <rect x="20" y="562" width="460" height="22" fill="#EBF2FA" />
      <rect x="452" y="562" width="28" height="22" fill="url(#hv-hatch)" stroke="none" />
      <line x1="0" y1="584" x2="500" y2="584" />
    </g>
    <!-- mosaic band -->
    <g stroke="#10273E" stroke-width="1.25">
      {Array.from({ length: 22 }, (_, i) => (
        <rect x={30 + i * 20} y="592" width="14" height="6" rx="1" fill={[3, 9, 15].includes(i) ? '#2F73B6' : '#EBF2FA'} />
      ))}
    </g>
  </svg>

  <!-- Phone (front layer) -->
  <div class="hero-phone absolute left-1/2 top-[19%] w-[54%] -translate-x-1/2" data-parallax="-0.06" aria-hidden="true">
    <div class="rounded-[2.2rem] bg-primary-800 p-2.5 shadow-[0_30px_60px_-25px_rgba(16,39,62,.55)]">
      <div class="relative overflow-hidden rounded-[1.7rem] bg-white">
        {screenshot
          ? <Img src={screenshot} alt="" width={390} height={844} class="block w-full" priority />
          : (
              <div class="px-4 pb-5 pt-7 font-inter">
                <div class="mx-auto mb-4 h-1.5 w-16 rounded-full bg-secondary-200"></div>
                <p class="font-space text-lg font-bold text-heading-text">Vade takibi</p>
                <p class="text-xs text-label-text">3 vadesi geçti, 2 yaklaşıyor</p>
                <ul class="mt-3 space-y-2">
                  {rows.map(r => (
                    <li class:list={['flex items-center justify-between rounded-xl border px-3 py-2', r.late ? 'border-danger-100 bg-danger-50' : 'border-warning-200 bg-warning-50']}>
                      <span class="min-w-0">
                        <span class="block truncate text-[13px] font-semibold text-heading-text">{r.name}</span>
                        <span class:list={['text-[11px] font-medium', r.late ? 'text-danger-700' : 'text-warning-800']}>{r.late ? `${r.days} gün gecikti` : `${r.days} gün kaldı`}</span>
                      </span>
                      <span class="text-[13px] font-bold text-heading-text">{r.amount}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-4 flex gap-2">
                  <span class="flex-1 rounded-lg bg-primary-800 py-2 text-center text-xs font-semibold text-white">SMS hatırlat</span>
                  <span class="flex-1 rounded-lg border border-secondary-200 py-2 text-center text-xs font-semibold text-heading-text">Ekstre gönder</span>
                </div>
              </div>
            )}
      </div>
    </div>
  </div>

  <!-- Notification chip (asymmetric life) -->
  <div class="hero-chip absolute right-0 top-[8%] flex items-center gap-3 rounded-2xl border border-border-color bg-white px-4 py-3 shadow-sm sm:right-[-4%]" data-parallax="-0.12" aria-hidden="true">
    <span class="flex size-9 items-center justify-center rounded-full bg-primary-50 text-lg text-primary-700"><i class="ri-notification-3-line"></i></span>
    <span class="text-left">
      <span class="block text-sm font-semibold text-heading-text">10:30 · Vadesi geçenler</span>
      <span class="block text-xs text-label-text">Bugün aranacak 3 müşteri</span>
    </span>
  </div>
</figure>
