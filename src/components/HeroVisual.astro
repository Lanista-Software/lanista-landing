---
import Icon from '~/components/Icon.astro'
/**
 * Home hero visual (Lanista illustration style): a classical arch on a plinth framing a phone
 * that shows Lanista Yedek Parça's "Vadesi geçenler" screen with sample data.
 * Layers carry data-parallax so the motion script can separate them.
 * The phone screen is a real app screenshot from Contentrain (products.hero_screenshot).
 */
import Img from '~/components/Img.astro'

interface Props {
  label: string
  /** Phone screenshot (390×844) from Contentrain. */
  screenshot?: string
  /** Floating notification chip; omit to hide. */
  chip?: { title: string, text: string } | null
  /** Products without a screenshot yet: a large icon tile stands inside the arch instead of the phone. */
  icon?: string
}
const { label, screenshot, chip, icon } = Astro.props
---

<figure class="hero-visual relative mx-auto aspect-[5/6] w-full max-w-[520px]" role="img" aria-label={label}>
  <!-- Arch, columns, plinth (back layer) -->
  <svg class="absolute inset-0 size-full" viewBox="0 0 500 600" fill="none" aria-hidden="true" data-parallax="0.04">
    <defs>
      <pattern id="hv-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="#9ABFE5" stroke-width="1.5" />
      </pattern>
    </defs>
    <g stroke="#10273E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <!-- archivolt + piers -->
      <path class="hv-draw" pathLength="1" d="M70 540 V250 A180 180 0 0 1 430 250 V540 H382 V250 A132 132 0 0 0 118 250 V540 Z" fill="#EBF2FA" />
      <rect x="420" y="250" width="9" height="290" fill="url(#hv-hatch)" stroke="none" />
      <rect x="60" y="242" width="70" height="14" fill="#C2D9EF" />
      <rect x="370" y="242" width="70" height="14" fill="#C2D9EF" />
      <g class="hv-joints" stroke-width="1.25">
        <line x1="133" y1="187" x2="90" y2="168" /><line x1="160" y1="150" x2="130" y2="113" />
        <line x1="199" y1="125" x2="183" y2="80" /><line x1="301" y1="125" x2="317" y2="80" />
        <line x1="340" y1="150" x2="370" y2="113" /><line x1="367" y1="187" x2="410" y2="168" />
      </g>
      <!-- keystone: the single red element -->
      <polygon class="hv-keystone" points="225,63 275,63 268,120 232,120" fill="#E31F30" />
      <!-- plinth + ground -->
      <rect x="40" y="540" width="420" height="22" fill="#C2D9EF" />
      <rect x="20" y="562" width="460" height="22" fill="#EBF2FA" />
      <rect x="452" y="562" width="28" height="22" fill="url(#hv-hatch)" stroke="none" />
      <line x1="0" y1="584" x2="500" y2="584" />
    </g>
    <!-- mosaic band -->
    <g stroke="#10273E" stroke-width="1.25">
      {Array.from({ length: 22 }, (_, i) => (
        <rect x={30 + i * 20} y="592" width="14" height="6" rx="1" fill={[3, 9, 15].includes(i) ? '#2F73B6' : '#EBF2FA'} />
      ))}
    </g>
  </svg>

  {!screenshot && icon && (
    <div class="absolute left-1/2 top-[34%] -translate-x-1/2" data-parallax="-0.06" aria-hidden="true">
      <div class="hv-rise flex size-36 items-center justify-center rounded-[2rem] bg-white text-7xl text-primary-700 shadow-[0_30px_60px_-25px_rgba(16,39,62,.55)] ring-2 ring-primary-800 md:size-44 md:text-8xl">
        <Icon name={icon} />
      </div>
    </div>
  )}

  <!-- Phone (front layer) -->
  {screenshot && (
<div class="hero-phone absolute left-1/2 top-[19%] w-[54%] -translate-x-1/2" data-parallax="-0.06" aria-hidden="true">
    <div class="hv-rise rounded-[2.2rem] bg-primary-800 p-2.5 shadow-[0_30px_60px_-25px_rgba(16,39,62,.55)]">
      <div class="relative overflow-hidden rounded-[1.7rem] bg-white">
        <Img src={screenshot} alt="" width={390} height={844} class="block w-full" priority />
      </div>
    </div>
  </div>
)}

  <!-- Notification chip (asymmetric life) -->
  {chip && (
<div class="hero-chip hv-pop absolute right-0 top-[8%] flex items-center gap-3 rounded-2xl border border-border-color bg-white px-4 py-3 shadow-sm sm:right-[-4%]" data-parallax="-0.12" aria-hidden="true">
    <span class="flex size-9 items-center justify-center rounded-full bg-primary-50 text-lg text-primary-700"><Icon name="ri-notification-3-line" /></span>
    <span class="text-left">
      <span class="block text-sm font-semibold text-heading-text">{chip.title}</span>
      <span class="block text-xs text-label-text">{chip.text}</span>
    </span>
  </div>
)}
</figure>

<style>
  /* One orchestrated entrance: arch draws → keystone drops → phone rises → rows → chip. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hv-draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      fill-opacity: 0;
      animation: hv-draw 0.9s cubic-bezier(.6, 0, .2, 1) forwards, hv-fill 0.5s 0.6s ease-out forwards;
    }
    :global(.js) .hv-joints { opacity: 0; animation: hv-fade 0.4s 0.8s forwards; }
    :global(.js) .hv-keystone {
      transform-box: fill-box;
      transform-origin: center;
      opacity: 0;
      animation: hv-drop 0.55s 0.95s cubic-bezier(.3, 1.4, .5, 1) forwards;
    }
    :global(.js) .hv-rise { opacity: 0; animation: hv-rise 0.7s 0.35s cubic-bezier(.2, .8, .2, 1) forwards; }
    :global(.js) .hv-row { opacity: 0; animation: hv-row 0.45s calc(0.9s + var(--i) * 0.08s) ease-out forwards; }
    :global(.js) .hv-pop { opacity: 0; animation: hv-pop 0.5s 1.5s cubic-bezier(.3, 1.3, .5, 1) forwards; }
  }
  @keyframes hv-draw { to { stroke-dashoffset: 0; } }
  @keyframes hv-fill { to { fill-opacity: 1; } }
  @keyframes hv-fade { to { opacity: 1; } }
  @keyframes hv-drop { 0% { opacity: 1; transform: translateY(-70px); } 100% { opacity: 1; transform: translateY(0); } }
  @keyframes hv-rise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes hv-row { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }
  @keyframes hv-pop { from { opacity: 0; transform: scale(.92) translateY(6px); } to { opacity: 1; transform: none; } }
</style>
