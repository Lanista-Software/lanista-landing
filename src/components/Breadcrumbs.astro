---
import type { Locale } from '~/lib/i18n'
import { localePath, t } from '~/lib/i18n'

interface Props { locale: Locale, trail: { name: string, path: string }[] }
const { locale, trail } = Astro.props
---

<nav aria-label={t(locale)('a11y.breadcrumb')} class="mb-6">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-label-text">
    {trail.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <i class="ri-arrow-right-s-line" aria-hidden="true"></i>}
        {i < trail.length - 1
          ? <a href={localePath(item.path, locale)} class="font-medium text-primary-600 hover:text-primary-700 hover:underline">{item.name}</a>
          : <span aria-current="page" class="text-body-text">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
