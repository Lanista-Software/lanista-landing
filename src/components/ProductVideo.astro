---
/**
 * Short silent screen recording in a phone frame. Autoplays muted+looped only
 * when the visitor has not asked for reduced motion (script below); otherwise
 * the poster stays with native controls. Captions describe what happens.
 */
interface Props { src: string, poster: string, title: string, caption?: string, id: string }
const { src, poster, title, caption, id } = Astro.props
---

<figure class="product-video reveal flex flex-col items-center gap-5 md:flex-row md:items-center md:gap-10">
  <div class="w-[260px] shrink-0 rounded-[2rem] bg-primary-800 p-2 shadow-[0_24px_48px_-24px_rgba(16,39,62,.5)]">
    <video
      id={id}
      class="block aspect-[390/844] w-full rounded-[1.6rem] bg-white"
      src={src}
      poster={poster}
      muted
      loop
      playsinline
      preload="none"
      controls
      width="390"
      height="844"
      aria-describedby={`${id}-cap`}
      data-autoplay
    ></video>
  </div>
  <figcaption id={`${id}-cap`} class="max-w-sm text-center md:text-left">
    <span class="block font-space text-xl font-bold text-heading-text">{title}</span>
    {caption && <span class="mt-2 block text-body-text">{caption}</span>}
  </figcaption>
</figure>

<script>
  // Play only while visible, and never for prefers-reduced-motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement
        if (e.isIntersecting) {
          v.controls = false
          v.play().catch(() => {
            v.controls = true
          })
        }
        else {
          v.pause()
        }
      }
    }, { threshold: 0.4 })
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach(v => io.observe(v))
  }
</script>
